# Copy to .env and adjust. .env is git-ignored.

COURSE_NAME="Database Management Systems"

# LLM provider: "ollama" locally; "openai_compat" for a hosted free-tier API later
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Fallback if the 4B model is too slow: qwen2.5:3b
NUM_CTX=4096
TEMPERATURE=0.2

# Only used when LLM_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Embeddings and retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=data/chroma
COLLECTION_NAME=dbms
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
RELEVANCE_THRESHOLD=0.45

# Recommended Ollama server settings for 8 GB RAM (set as system env vars, not here):
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1
